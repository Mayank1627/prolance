# Prolance Environment Configuration
# Duplicate this file as .env for local development

# Django Secret Key (Generate a random 50+ character string for production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Debug Mode (Set to False in production)
DEBUG=True

# Allowed Hosts (Comma-separated hostnames or domains)
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com

# CSRF Trusted Origins (Comma-separated URLs with scheme)
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost,https://*.onrender.com

# Render Persistent Disk Path for SQLite (Optional - if omitted, stores in project root)
# When deploying to Render with a persistent disk mounted at /var/data, set:
# SQLITE_DIR=/var/data

# Email Backend (defaults to console for development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SSL Security (Set to True in production on HTTPS)
SECURE_SSL_REDIRECT=False
